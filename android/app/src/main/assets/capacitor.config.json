{
	"appId": "com.d4exam.app",
	"appName": "D4EXAM",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"backgroundColor": "#070D1B",
			"showSpinner": false
		},
		"PushNotifications": {
