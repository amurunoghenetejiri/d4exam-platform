# Public (safe in browser) — Vercel / Lovable env
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key

# Server only — never expose to the browser
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional app origin (push icons, deep links)
APP_URL=https://d4exam-platform.vercel.app

# Firebase Cloud Messaging HTTP v1 (server)
# Paste the full service-account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=d4exam-6506a

# Legacy FCM only if Cloud Messaging API (Legacy) is enabled
# FCM_SERVER_KEY=
